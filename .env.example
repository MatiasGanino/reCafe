# Base de datos. En Vercel se inyecta sola al conectar el store al proyecto.
# Local: vercel env pull .env --environment=production
REDIS_URL=

# Login del panel. Generalas con: npm run clave-panel
# La contraseña en texto plano no va acá ni en ningún lado: PANEL_CLAVE_HASH es
# un hash scrypt irreversible.
PANEL_USUARIO=
PANEL_CLAVE_HASH=
