---
import { comoLlegar, contacto, horariosVisibles, mapa } from "../data/cafeteria";

const tarjetas = [
  {
    rotulo: "Dónde",
    titulo: contacto.direccion,
    href: mapa.enlace,
    lineas: [{ texto: contacto.barrio }, ...comoLlegar.map((texto) => ({ texto }))],
  },
  { rotulo: "Cuándo", titulo: "Horarios", lineas: horariosVisibles },
];
---

<section class="seccion" id="visita">
  <div class="envoltura">
    <div class="encabezado revelar">
      <h2>Un solo local, a propósito!</h2>
    </div>

    <div class="tarjetas revelar">
      {
        tarjetas.map((t) => (
          <div class="tarjeta">
            <p class="rotulo">{t.rotulo}</p>
            <h3>
              {"href" in t && t.href ? (
                <a href={t.href} target="_blank" rel="noopener">
                  {t.titulo}
                </a>
              ) : (
                t.titulo
              )}
            </h3>
            <ul>
              {t.lineas.map((l) => (
                <li>
                  <span>{l.texto}</span>
                  {"dato" in l && l.dato && <b>{l.dato}</b>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="mapa">
        <iframe
          src={mapa.embebido}
          title={`Mapa: ${contacto.direccion}, ${contacto.barrio}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a class="abrir-mapa" href={mapa.enlace} target="_blank" rel="noopener">Abrir en Google Maps ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .tarjeta {
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 14px;
    padding: 26px 24px;
  }

  .tarjeta h3 {
    margin: 10px 0 12px;
  }

  .tarjeta h3 a {
    text-decoration: underline;
    text-decoration-color: var(--durazno);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .tarjeta h3 a:hover {
    color: var(--terracota);
  }

  /* Ocupa el lugar de una tarjeta más y se estira a la altura de la fila. */
  .mapa {
    position: relative;
    min-height: 240px;
    border: 1px solid var(--linea);
    border-radius: 14px;
    overflow: hidden;
    background: var(--papel);
  }

  .mapa iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .abrir-mapa {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--tinta);
    color: var(--crema);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .abrir-mapa:hover {
    background: var(--terracota);
  }

  @media (max-width: 600px) {
    .mapa {
      min-height: 260px;
    }
  }

  .tarjeta ul {
    list-style: none;
    font-size: 15px;
    color: var(--humo);
  }

  .tarjeta li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 4px 0;
  }

  .tarjeta li b {
    font-weight: 600;
    color: var(--tinta);
  }
</style>
