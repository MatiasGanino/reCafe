---
import { contacto } from "../data/cafeteria";
---

<section class="seccion" id="contacto">
  <div class="envoltura centrado">
    <h2>Escribinos</h2>
    <p>Eventos, alguna consulta, o si te olvidaste algo en la mesa.</p>
    <div class="acciones acciones--centradas">
      <a class="enlace" href={contacto.instagramChat} target="_blank" rel="noopener">Escribinos por Instagram</a>
    </div>
  </div>
</section>

<style>
  .centrado {
    text-align: center;
  }

  h2 {
    margin-top: 8px;
  }

  p {
    margin: 14px auto 0;
  }
</style>
