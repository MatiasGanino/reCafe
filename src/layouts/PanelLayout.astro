---
import "../styles/global.css";

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400..700&family=Archivo:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="envoltura panel">
      <slot />
    </div>

    <style is:global>
      .panel {
        max-width: 880px;
        padding-block: 40px 80px;
      }

      .cabecera {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
      }

      .cabecera h1 {
        font-size: clamp(2rem, 5vw, 2.6rem);
      }

      .sutil {
        color: var(--humo);
        font-size: 14.5px;
        margin: 0;
      }

      .aviso {
        background: var(--durazno);
        color: var(--tinta);
        font-weight: 600;
        font-size: 15px;
        padding: 12px 18px;
        border-radius: 10px;
        margin-bottom: 22px;
        max-width: none;
      }

      .tarjeta {
        background: var(--papel);
        border: 1px solid var(--linea);
        border-radius: 14px;
        padding: 26px 24px;
        margin-bottom: 24px;
      }

      .tarjeta h2 {
        font-size: 1.4rem;
        margin-bottom: 20px;
      }

      /* ── formulario ─────────────────────────────────── */
      .formulario {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 20px;
      }

      .campo {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .campo--ancho {
        grid-column: 1 / -1;
      }

      .campo > span {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .campo > span i {
        font-weight: 400;
        font-style: normal;
        color: var(--humo);
      }

      .campo input {
        font: inherit;
        font-size: 15px;
        color: var(--tinta);
        background: var(--crema);
        border: 1px solid var(--linea);
        border-radius: 8px;
        padding: 10px 12px;
      }

      .campo input:focus-visible {
        border-color: var(--durazno);
      }

      .campo input[aria-invalid="true"] {
        border-color: var(--terracota);
      }

      .error {
        font-size: 13px;
        font-style: normal;
        color: var(--terracota);
      }

      .checkbox {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 15px;
      }

      .acciones-form {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 4px;
      }

      .formulario button {
        font: inherit;
        cursor: pointer;
        border: none;
      }

      /* ── lista ──────────────────────────────────────── */
      .lista {
        list-style: none;
      }

      .fila {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        align-items: center;
        gap: 18px;
        padding: 14px 0;
        border-bottom: 1px solid var(--linea);
      }

      .fila:last-child {
        border-bottom: none;
      }

      .fila--oculta .datos {
        opacity: 0.5;
      }

      .orden {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .orden button {
        font: inherit;
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
        background: none;
        border: 1px solid var(--linea);
        border-radius: 6px;
        padding: 3px 6px;
        color: var(--humo);
      }

      .orden button:hover:not(:disabled) {
        border-color: var(--durazno);
        color: var(--tinta);
      }

      .orden button:disabled {
        opacity: 0.3;
        cursor: default;
      }

      .datos .titulo {
        font-weight: 600;
        font-size: 16px;
        margin: 0 0 2px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        max-width: none;
        color: var(--tinta);
      }

      .chip {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--linea);
        color: var(--humo);
      }

      .chip--nota {
        background: transparent;
        border: 1px solid var(--terracota);
        color: var(--terracota);
      }

      .fila .precio {
        font-family: var(--display);
        font-size: 1.15rem;
        font-variant-numeric: tabular-nums;
      }

      .acciones-fila {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .borrar {
        font: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        background: none;
        border: none;
        color: var(--terracota);
        padding: 0;
      }

      .borrar:hover {
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        .formulario {
          grid-template-columns: 1fr;
        }

        .fila {
          grid-template-columns: auto 1fr;
          row-gap: 8px;
        }

        .fila .precio,
        .acciones-fila {
          grid-column: 2;
        }
      }
    </style>
  </body>
</html>
